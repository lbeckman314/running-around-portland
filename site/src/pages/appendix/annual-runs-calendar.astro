---

<PageLayout meta={meta}>
	<h1 class="title mb-2">Calendar of Annual Runs</h1>
	<p class="text-muted mb-4 text-sm">
		Appendix from <em>Running Around Portland</em> (1979) — dates, distances and starting points
		as printed; races listed here have long since changed or ended, kept for the historical
		record rather than as a current schedule.
	</p>
	<p class="mb-12 rounded-md border border-dashed border-muted/40 bg-quote/5 p-3 text-sm text-muted">
		The scanned pages for <strong>April, May, June, and early July</strong> came out blank — that
		stretch of the calendar is missing here pending a rescan of the original book.
	</p>
	{
		months.map(([month, races]) => (
			<section class="mb-12">
				<h2 class="title mb-4 text-lg">{month}</h2>
				<ul class="space-y-4">
					{races.map((r) => (
						<li class="grid gap-1 sm:grid-cols-[10rem_1fr]">
							<span class="text-muted text-sm">{r.date}</span>
							<span>
								<strong>{r.race}</strong> — {r.distance}
								<br />
								<span class="text-muted text-sm">{r.start}</span>
							</span>
						</li>
					))}
				</ul>
			</section>
		))
	}
	<p class="mt-4">
		<a class="cactus-link" href="/appendix/">← Back to appendices</a>
	</p>
</PageLayout>
