---
import { menuLinks, siteConfig} from "@/site.config";
---

<footer
	class="full-bleed-bg mt-auto text-white flex w-full flex-col items-center justify-center gap-y-2 py-6 text-center align-top font-semibold sm:flex-row sm:justify-between sm:text-xs"
>
	<div class="me-0 sm:me-4">
		&copy; {siteConfig.publisher} {siteConfig.year} 🌲
	</div>
	<nav aria-label="Footer" class="sm:divide-white/50 flex gap-x-2 sm:gap-x-0 sm:divide-x">
		{
			menuLinks.map((link) => (
				<a class="px-4 py-2 hover:underline sm:py-0" href={link.path}>
					{link.title}
				</a>
			))
		}
	</nav>
</footer>
