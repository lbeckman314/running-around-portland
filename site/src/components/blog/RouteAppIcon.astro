---
import type { CollectionEntry } from "astro:content";
import { Image } from "astro:assets";
import RouteStats from "@/components/blog/RouteStats.astro";
import { postHref } from "@/data/post";

// Home-page tile styled like an iOS home-screen app: a rounded-square "icon"
// cropped from the route's hand-drawn map, with a short label underneath.
type Props = {
	post: CollectionEntry<"post">;
};

const { post } = Astro.props;
const { data } = post;
const title = data.routeNumber !== undefined ? data.title.replace(/^\d+\.\s*/, "") : data.title;
const meta = [
	data.distanceMiles !== undefined ? `${data.distanceMiles} mi` : undefined,
	data.difficulty !== undefined ? `difficulty ${data.difficulty}/10` : undefined,
]
	.filter((part) => part !== undefined)
	.join(" · ");
// Only routes get the hover card; e.g. the Wildwood fold-out has no stats to show.
const hasStats = data.routeNumber !== undefined;
---

<div class="route-app-wrap">

<a class="route-app group flex flex-col items-center no-underline" href={postHref(post)}>
	<span class="route-app-icon">
		{
			data.routeMap ? (
				<Image src={data.routeMap.src} alt="" width={240} class="route-app-img" />
			) : (
				<span class="route-app-fallback" aria-hidden="true">
					{title.charAt(0)}
				</span>
			)
		}
		{
			data.routeNumber !== undefined && (
				<span class="route-app-badge" aria-hidden="true">
					{data.routeNumber}
				</span>
			)
		}
	</span>
	<span class="route-app-label group-hover:decoration-link mt-2 text-center text-xs font-semibold leading-tight underline-offset-2 group-hover:underline group-hover:decoration-2">
		{title}
	</span>
	{meta && <span class="text-muted mt-0.5 text-center text-xs leading-tight">{meta}</span>}
	{data.draft && <span class="text-xs font-semibold text-red-500">(Draft)</span>}
</a>
{
	/* Visual preview only: the same stats are on the route page, so screen readers skip it
	   rather than hearing every stat for every icon while tabbing through the grid. */
	hasStats && (
		<div class="route-app-pop" aria-hidden="true">
			<RouteStats
				compact
				routeNumber={data.routeNumber}
				section={data.section}
				distanceMiles={data.distanceMiles}
				distanceKm={data.distanceKm}
				distanceLabel={data.distanceLabel}
				difficulty={data.difficulty}
				beginningPoint={data.beginningPoint}
				runningSurface={data.runningSurface}
				suggestedBy={data.suggestedBy}
				conditions={data.routeConditions}
			/>
		</div>
	)
}
</div>

<script>
	// Keep each card inside the page: icons in the outer grid columns would otherwise push a
	// centred card past the viewport edge, which also makes the whole page scroll sideways
	// (hidden cards still take up layout space). Re-run on resize since the column count is
	// responsive.
	const GUTTER = 16;
	function placeAll() {
		const pageWidth = document.documentElement.clientWidth;
		for (const pop of document.querySelectorAll<HTMLElement>(".route-app-pop")) {
			// Work from the icon's centre and the card's width rather than the card's own rect,
			// which is mid-transition (transformed) whenever a card is opening or closing.
			const wrap = pop.parentElement?.getBoundingClientRect();
			if (!wrap) continue;
			const left = wrap.left + wrap.width / 2 - pop.offsetWidth / 2;
			const overLeft = GUTTER - left;
			const overRight = left + pop.offsetWidth - (pageWidth - GUTTER);
			const shift = overLeft > 0 ? overLeft : overRight > 0 ? -overRight : 0;
			pop.style.setProperty("--shift", `${shift}px`);
		}
	}
	placeAll();
	let frame = 0;
	window.addEventListener("resize", () => {
		cancelAnimationFrame(frame);
		frame = requestAnimationFrame(placeAll);
	});
</script>

<style>
	.route-app-wrap {
		position: relative;
	}

	/* Hover card, opening above the icon (opening below would slide under the next
	   section's band, which paints later). Hidden until hover or keyboard focus. */
	.route-app-pop {
		--shift: 0px;
		position: absolute;
		bottom: calc(100% + 0.5rem);
		left: 50%;
		z-index: 20;
		width: min(22rem, calc(100vw - 2rem));
		transform: translateX(calc(-50% + var(--shift))) translateY(4px);
		opacity: 0;
		visibility: hidden;
		pointer-events: none;
		filter: drop-shadow(0 8px 20px rgb(0 0 0 / 0.18));
		transition:
			opacity 150ms ease,
			transform 150ms ease,
			visibility 0s linear 150ms;
	}

	.route-app-wrap:focus-within {
		z-index: 20;
	}

	.route-app-wrap:focus-within .route-app-pop {
		opacity: 1;
		visibility: visible;
		transform: translateX(calc(-50% + var(--shift)));
		transition-delay: 0s;
	}

	/* Only real hover devices: on touch, a tap should just open the route. A short delay
	   stops cards flashing open while the pointer sweeps across the grid. */
	@media (hover: hover) {
		.route-app-wrap:hover {
			z-index: 20;
		}

		.route-app-wrap:hover .route-app-pop {
			opacity: 1;
			visibility: visible;
			transform: translateX(calc(-50% + var(--shift)));
			transition-delay: 250ms;
		}
	}

	.route-app {
		width: 100%;
		max-width: 7.5rem;
		margin-inline: auto;
	}

	.route-app-icon {
		position: relative;
		display: block;
		width: 100%;
		aspect-ratio: 1;
		/* ~22% radius approximates the iOS icon squircle. */
		border-radius: 22%;
		overflow: hidden;
		background: #fffaf3;
		box-shadow:
			0 1px 2px rgb(0 0 0 / 0.12),
			0 4px 12px rgb(0 0 0 / 0.1);
		transition:
			transform 150ms ease,
			box-shadow 150ms ease;
	}

	.route-app:hover .route-app-icon,
	.route-app:focus-visible .route-app-icon {
		transform: translateY(-2px) scale(1.04);
		box-shadow:
			0 2px 4px rgb(0 0 0 / 0.14),
			0 8px 20px rgb(0 0 0 / 0.16);
	}

	.route-app:active .route-app-icon {
		transform: scale(0.95);
	}

	.route-app-img {
		width: 100%;
		height: 100%;
		/* The scans are tall (map above, elevation profile below); crop to the map. */
		object-fit: cover;
		object-position: top;
	}

	.route-app-fallback {
		display: grid;
		place-items: center;
		width: 100%;
		height: 100%;
		background: var(--color-accent);
		color: var(--color-global-bg);
		font-family: var(--font-shrikhand);
		font-size: 2.5rem;
	}

	/* Notification-style badge in the top-right corner. */
	.route-app-badge {
		position: absolute;
		top: 6%;
		right: 6%;
		min-width: 1.5rem;
		height: 1.5rem;
		padding-inline: 0.35rem;
		display: grid;
		place-items: center;
		border-radius: 999px;
		background: var(--color-accent);
		color: var(--color-global-bg);
		font-size: 0.7rem;
		font-weight: 700;
		box-shadow: 0 1px 3px rgb(0 0 0 / 0.25);
	}

	.route-app-label {
		display: -webkit-box;
		-webkit-line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}
</style>
