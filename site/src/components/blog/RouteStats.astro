---
interface Conditions {
	aesthetics?: number | undefined;
	badWeatherRunning?: number | undefined;
	autoTraffic?: number | undefined;
}

interface Props {
	routeNumber?: number | undefined;
	section?: string | undefined;
	distanceMiles?: number | undefined;
	distanceKm?: number | undefined;
	distanceLabel?: string | undefined;
	difficulty?: number | undefined;
	beginningPoint?: string | undefined;
	runningSurface?: string | undefined;
	suggestedBy?: string | undefined;
	conditions?: Conditions | undefined;
	/** Tighter layout for the home page hover card (no outer margin, fixed label column). */
	compact?: boolean;
}

const {
	routeNumber,
	section,
	distanceMiles,
	distanceKm,
	distanceLabel,
	difficulty,
	beginningPoint,
	runningSurface,
	suggestedBy,
	conditions,
	compact = false,
} = Astro.props;

const row = compact ? "grid grid-cols-[7.5rem_1fr] gap-x-2" : "grid gap-1 sm:grid-cols-[9rem_1fr]";

const conditionRows: Array<[string, number | undefined]> = [
	["Aesthetics", conditions?.aesthetics],
	["Bad weather running", conditions?.badWeatherRunning],
	["Auto traffic", conditions?.autoTraffic],
];

const distance =
	distanceLabel ??
	(distanceMiles !== undefined
		? `${distanceMiles} mi${distanceKm !== undefined ? ` (${distanceKm} km)` : ""}`
		: undefined);
---

<aside
	class:list={[
		"not-prose rounded-lg border border-muted/30",
		compact ? "bg-global-bg p-4 text-sm" : "bg-quote/5 my-8 p-5",
	]}
	aria-label="Route stats"
>
	{
		(routeNumber !== undefined || section) && (
			<p class="mb-3 text-xs tracking-wide text-muted uppercase">
				{routeNumber !== undefined ? `Route ${routeNumber}` : ""}
				{routeNumber !== undefined && section ? " · " : ""}
				{section}
			</p>
		)
	}

	<dl class:list={["grid", compact ? "gap-2" : "gap-3"]}>
		{
			distance && (
				<div class={row}>
					<dt class="text-sm font-semibold text-muted">Distance</dt>
					<dd class="m-0">{distance}</dd>
				</div>
			)
		}

		{
			difficulty !== undefined && (
				<div class={row}>
					<dt class="text-sm font-semibold text-muted">Difficulty</dt>
					<dd class="m-0 flex items-center gap-2">
						<span
							class="inline-block h-2 w-24 overflow-hidden rounded-full bg-muted/30"
							aria-hidden="true"
						>
							<span
								class="block h-full bg-accent"
								style={`width: ${(difficulty / 10) * 100}%`}
							/>
						</span>
						<span>{difficulty} / 10</span>
					</dd>
				</div>
			)
		}

		{
			beginningPoint && (
				<div class={row}>
					<dt class="text-sm font-semibold text-muted">Beginning point</dt>
					<dd class="m-0">{beginningPoint}</dd>
				</div>
			)
		}

		{
			runningSurface && (
				<div class={row}>
					<dt class="text-sm font-semibold text-muted">Running surface</dt>
					<dd class="m-0">{runningSurface}</dd>
				</div>
			)
		}

		{
			conditionRows.some(([, value]) => value !== undefined) && (
				<div class={row}>
					<dt class="text-sm font-semibold text-muted">
						Conditions
						<span class="block text-xs font-normal">(best = 10)</span>
					</dt>
					<dd class="m-0">
						<ul class="grid list-none gap-2.5 p-0">
							{conditionRows.map(([label, value]) =>
								value !== undefined ? (
									<li class="grid gap-1">
										<span class="flex items-baseline justify-between gap-2">
											<span>{label}</span>
											<span class="tabular-nums">
												<strong>{value}</strong>/10
											</span>
										</span>
										<span
											class="block h-2 w-full overflow-hidden rounded-full bg-muted/30"
											aria-hidden="true"
										>
											<span
												class="block h-full rounded-full bg-accent"
												style={`width: ${(value / 10) * 100}%`}
											/>
										</span>
									</li>
								) : null,
							)}
						</ul>
					</dd>
				</div>
			)
		}

		{
			suggestedBy && (
				<div class={row}>
					<dt class="text-sm font-semibold text-muted">Suggested by</dt>
					<dd class="m-0">{suggestedBy}</dd>
				</div>
			)
		}
	</dl>
</aside>
