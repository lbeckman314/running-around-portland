---
import BaseHead from "@/components/BaseHead.astro";
import Footer from "@/components/layout/Footer.astro";
import Header from "@/components/layout/Header.astro";
import SkipLink from "@/components/SkipLink.astro";
import { siteConfig } from "@/site.config";
import type { SiteMeta } from "@/types";

interface Props {
	meta: SiteMeta;
	/** Widen the page shell — used by the "book spread" route posts. */
	wide?: boolean;
}

const {
	meta: { articleDate, description = siteConfig.description, ogImage, title },
	wide = true,
} = Astro.props;
---

<html class="scroll-smooth" lang={siteConfig.lang}>
	<head>
		<BaseHead articleDate={articleDate} description={description} ogImage={ogImage} title={title} />
	</head>
	<body
		class:list={[
			"bg-global-bg text-global-text mx-auto flex min-h-screen flex-col px-4 font-mono text-sm font-normal antialiased sm:px-8",
			wide ? "max-w-6xl" : "max-w-3xl",
		]}
	>
		<SkipLink />
		<Header />
		<main id="main" class="pb-20">
			<slot />
		</main>
		<Footer />
		<script is:inline type="speculationrules">
			{
				"prefetch": [
					{
						"where": {
							"href_matches": "/*"
						},
						"eagerness": "immediate"
					}
				],
				"prerender": [
					{
						"where": {
							"href_matches": "/*"
						},
						"eagerness": "moderate"
					}
				]
			}
		</script>
	</body>
</html>
